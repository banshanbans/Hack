# Server-side only. Never commit a real key.
ANJU_VISION_PROVIDER=ark
ARK_API_KEY=
ANJU_ARK_MODEL=doubao-seed-2-1-pro-260628
# Optional override for a private gateway or another Ark region.
ANJU_ARK_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/responses

# Alternative provider configuration.
OPENAI_API_KEY=
ANJU_OPENAI_MODEL=gpt-5.6-sol
ANJU_ANALYSIS_TIMEOUT_SECONDS=60
# Process-wide model concurrency. Production uses one Uvicorn worker with SQLite.
ANJU_TURBO_MAX_CONCURRENCY=2
ANJU_PRO_MAX_CONCURRENCY=1
ANJU_SHARE_TTL_HOURS=24
ANJU_DB_PATH=services/backend/data/anju.db
ANJU_MEDIA_ROOT=services/backend/data/media
ANJU_STATIC_ROOT=apps/web/dist
ANJU_ENABLE_API_DOCS=0
ANJU_ALLOWED_HOSTS=127.0.0.1,localhost
# Only trust the local edge proxy by default; use explicit IPs in production.
ANJU_FORWARDED_ALLOW_IPS=127.0.0.1
# Explicit development fixture only; keep disabled in real analysis.
ANJU_MOCK_ANALYSIS=0

# Legacy H5 video analysis is cancelled; keep this compatibility switch disabled.
ANJU_ENABLE_H5_VIDEO=0
# H5 and iOS use the same home-camera discovery contract. Enable them independently for staged rollout.
ANJU_ENABLE_H5_CAMERA=0
ANJU_ENABLE_IOS_HOME_CAMERA=0
# Room-scoped AI advisor. Keep disabled until H5 Web RTC and iOS native RTC gates pass.
ANJU_ENABLE_VOICE_ADVISOR=0
# Anonymous general knowledge advisor. Deploy API/H5 first and enable only after text, deletion and RTC smoke tests.
ANJU_ENABLE_KNOWLEDGE_ADVISOR=0
# Optional; when empty, reuses ANJU_ARK_MODEL or ANJU_OPENAI_MODEL.
ANJU_KNOWLEDGE_ADVISOR_MODEL=
ANJU_KNOWLEDGE_ADVISOR_TIMEOUT_SECONDS=30
# RTC video advisor requires an HTTPS Function Calling callback and an independent high-entropy signature.
ANJU_ENABLE_RTC_VIDEO_ADVISOR=0
# Hard-capped at 8 in the service to keep two of the purchased 10 TTS lanes in reserve.
ANJU_ADVISOR_MAX_ACTIVE_RTC=8
ANJU_ADVISOR_MAX_QUEUED=50
ANJU_ADVISOR_QUEUE_TTL_SECONDS=180
ANJU_ADVISOR_QUEUE_GRANT_SECONDS=20
ANJU_ADVISOR_DEVICE_LEASE_SECONDS=90
ANJU_VOLC_FC_CALLBACK_URL=
ANJU_VOLC_FC_CALLBACK_SIGNATURE=
ANJU_VOLC_RTC_APP_ID=
ANJU_VOLC_RTC_APP_KEY=
ANJU_VOLC_ACCESS_KEY=
ANJU_VOLC_SECRET_KEY=
# Optional direct Doubao Speech API credentials. The RTC StartVoiceChat template
# uses the bound volcano ASR/TTS resources instead of exposing this key.
ANJU_DOUBAO_SPEECH_API_KEY=
ANJU_DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
ANJU_DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
ANJU_DOUBAO_TTS_VOICE=zh_female_vv_uranus_bigtts
# Full StartVoiceChat provider template; may contain ASR/TTS/LLM secrets and must remain server-side.
ANJU_VOLC_VOICE_CONFIG_JSON=
ANJU_VOLC_VOICE_API_VERSION=2025-06-01
ANJU_VOLC_VOICE_MODEL_ID=doubao-seed-2-1-turbo-260628
ANJU_ENABLE_RENOVATION_PREVIEW=0
ANJU_ARK_IMAGE_EDIT_MODEL=doubao-seedream-4-5-251128
ANJU_ARK_IMAGE_EDIT_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
ANJU_ARK_IMAGE_EDIT_SIZE=2K
# Optional override for structured bbox grounding on the generated image; defaults to ANJU_ARK_MODEL.
ANJU_ARK_RENOVATION_GROUNDING_MODEL=doubao-seed-2-1-pro-260628
ANJU_RENOVATION_PREVIEW_TIMEOUT_SECONDS=90
ANJU_RENOVATION_PREVIEW_DAILY_LIMIT=3
ANJU_ARK_TURBO_MODEL=doubao-seed-2-0-lite-260215
ANJU_ARK_HOME_CAMERA_MODEL=doubao-seed-2-1-turbo-260628
ANJU_ARK_PRO_MODEL=doubao-seed-2-1-pro-260628
