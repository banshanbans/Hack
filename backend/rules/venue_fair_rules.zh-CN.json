  "rules": [
    {"risk_code":"floor_clutter","severity":"high","deduction":16,"title":"低位物体侵入通行区域","short_advice":"先移出通道并设置清晰边界","visual_cue":"豆包或懒人沙发、椅子、箱包、散落物等可定位低位物体明确落在或伸入可行走路径；休息区内未侵入路径的正常座椅不算","evidence_codes":["localized_obstruction_visible","path_intrusion_visible"],"required_evidence_codes":["localized_obstruction_visible","path_intrusion_visible"],"min_distinct_frames":1,"min_frame_interval_seconds":0,"solution_package_ids":["FAIR_FLOOR_CLUTTER_A","FAIR_FLOOR_CLUTTER_B","FAIR_FLOOR_CLUTTER_C"]},
    {"risk_code":"cable_crossing","severity":"high","deduction":14,"title":"裸露线缆或插排侵入通道","short_advice":"先移出或固定线缆和插排","visual_cue":"裸露电线、延长线、插排或未收束线缆明确铺在、横跨或延伸进入可行走路径；贴墙固定且不进入路径的线缆不算，完全封闭的线槽凸起改按 level_change 判断","evidence_codes":["exposed_cable_or_power_strip_visible","path_intrusion_visible"],"required_evidence_codes":["exposed_cable_or_power_strip_visible","path_intrusion_visible"],"min_distinct_frames":1,"min_frame_interval_seconds":0,"solution_package_ids":["FAIR_CABLE_CROSSING_A","FAIR_CABLE_CROSSING_B","FAIR_CABLE_CROSSING_C"]},
    {"risk_code":"narrow_path","severity":"high","deduction":12,"title":"主要通道偏窄","short_advice":"先移开占道物并恢复连续通道","visual_cue":"展位、成排桌椅或连续摆放物形成狭窄通道并明显压缩可通行宽度；单个豆包、椅子或箱包侵入路径优先按 floor_clutter 判断","evidence_codes":["restricted_path_visible"],"required_evidence_codes":["restricted_path_visible"],"min_distinct_frames":1,"min_frame_interval_seconds":0,"solution_package_ids":["FAIR_NARROW_PATH_A","FAIR_NARROW_PATH_B","FAIR_NARROW_PATH_C"]},
    {"risk_code":"loose_rug","severity":"medium","deduction":10,"title":"临时铺设物可能绊脚","short_advice":"固定边缘或移出主要动线","visual_cue":"地垫、地毯或临时铺设物边缘翘起或松动","evidence_codes":["loose_edge_visible"],"required_evidence_codes":["loose_edge_visible"],"min_distinct_frames":1,"min_frame_interval_seconds":0,"solution_package_ids":["FAIR_LOOSE_RUG_A","FAIR_LOOSE_RUG_B","FAIR_LOOSE_RUG_C"]},
    {"risk_code":"unstable_support","severity":"medium","deduction":8,"title":"现场物体稳定性待确认","short_advice":"暂停借力并由现场人员检查固定","visual_cue":"人员可能借力的物体有明显倾斜、晃动迹象或不可靠支撑方式","evidence_codes":["unstable_object_visible"],"required_evidence_codes":["unstable_object_visible"],"min_distinct_frames":1,"min_frame_interval_seconds":0,"solution_package_ids":["FAIR_UNSTABLE_SUPPORT_A","FAIR_UNSTABLE_SUPPORT_B","FAIR_UNSTABLE_SUPPORT_C"]},
    {"risk_code":"low_lighting","severity":"medium","deduction":6,"title":"通行区域照明不足","short_advice":"增加连续照明和清晰引导","visual_cue":"可见通行动线明显处于暗区且关键障碍难以辨认","evidence_codes":["dark_path_visible"],"required_evidence_codes":["dark_path_visible"],"min_distinct_frames":1,"min_frame_interval_seconds":0,"solution_package_ids":["FAIR_LOW_LIGHTING_A","FAIR_LOW_LIGHTING_B","FAIR_LOW_LIGHTING_C"]},
    {"risk_code":"sharp_corner","severity":"low","deduction":5,"title":"人员动线附近有突出尖角","short_advice":"加装防撞保护或调整位置","visual_cue":"人员动线附近有可定位、未防护的突出硬质边角","evidence_codes":["sharp_edge_visible"],"required_evidence_codes":["sharp_edge_visible"],"min_distinct_frames":1,"min_frame_interval_seconds":0,"solution_package_ids":["FAIR_SHARP_CORNER_A","FAIR_SHARP_CORNER_B","FAIR_SHARP_CORNER_C"]},
    {"risk_code":"wet_floor","severity":"high","deduction":14,"title":"地面有明显湿滑处","short_advice":"先擦干地面并提醒人员绕行","visual_cue":"地面可见积水、湿润反光或明确湿滑痕迹","evidence_codes":["wet_surface_visible"],"required_evidence_codes":["wet_surface_visible"],"min_distinct_frames":1,"min_frame_interval_seconds":0,"solution_package_ids":["FAIR_WET_FLOOR_A","FAIR_WET_FLOOR_B","FAIR_WET_FLOOR_C"]},
    {"risk_code":"level_change","severity":"medium","deduction":9,"title":"通行动线存在明显高差","short_advice":"增加醒目标识并保持附近无遮挡","visual_cue":"舞台或平台边缘、临时台阶、门槛、坡坎，或跨通道电缆保护槽形成可定位凸起并进入可行走路径；即使已有黄黑警示色仍可报告高差，只有与地面近乎齐平时不算","evidence_codes":["level_change_visible","path_intrusion_visible","edge_low_contrast_visible","warning_marking_visible","cable_cover_visible"],"required_evidence_codes":["level_change_visible","path_intrusion_visible"],"min_distinct_frames":1,"min_frame_interval_seconds":0,"solution_package_ids":["FAIR_LEVEL_CHANGE_A","FAIR_LEVEL_CHANGE_B","FAIR_LEVEL_CHANGE_C"]},
    {"risk_code":"crowded_path","severity":"medium","deduction":8,"title":"人员聚集持续影响通行","short_advice":"疏导人流并恢复连续通道","visual_cue":"人员持续聚集在同一区域并明显阻断或压缩通行动线","evidence_codes":["crowd_in_path_visible"],"required_evidence_codes":["crowd_in_path_visible"],"min_distinct_frames":2,"min_frame_interval_seconds":3,"solution_package_ids":["FAIR_CROWDED_PATH_A","FAIR_CROWDED_PATH_B","FAIR_CROWDED_PATH_C"]},
    {"risk_code":"marked_exit_obstruction","severity":"high","deduction":16,"title":"明确标识的出口通道被占用","short_advice":"立即清理标识出口前的可见障碍","visual_cue":"同一画面中既有清晰可读或可辨认的出口标识，也有可定位的通道障碍","evidence_codes":["marked_exit_visible","localized_obstruction_visible"],"required_evidence_codes":["marked_exit_visible","localized_obstruction_visible"],"min_distinct_frames":1,"min_frame_interval_seconds":0,"solution_package_ids":["FAIR_MARKED_EXIT_OBSTRUCTION_A","FAIR_MARKED_EXIT_OBSTRUCTION_B","FAIR_MARKED_EXIT_OBSTRUCTION_C"]},
    {"risk_code":"low_hanging_obstruction","severity":"medium","deduction":9,"title":"低位悬挂物侵入人员动线","short_advice":"移高、移开或隔离悬挂物","visual_cue":"悬挂物明显处于头肩高度并侵入人员通行动线","evidence_codes":["low_hanging_object_visible","path_intrusion_visible"],"required_evidence_codes":["low_hanging_object_visible","path_intrusion_visible"],"min_distinct_frames":1,"min_frame_interval_seconds":0,"solution_package_ids":["FAIR_LOW_HANGING_OBSTRUCTION_A","FAIR_LOW_HANGING_OBSTRUCTION_B","FAIR_LOW_HANGING_OBSTRUCTION_C"]}
  ]
