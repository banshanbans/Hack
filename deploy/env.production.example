ANJU_HOST=0.0.0.0
ANJU_PORT=8080
ANJU_DB_PATH=/app/data/anju.db
ANJU_MEDIA_ROOT=/app/data/media
ANJU_STATIC_ROOT=/app/apps/web/dist
ANJU_ALLOWED_HOSTS=shot.socialdog.cn,shotapi.socialdog.cn,127.0.0.1,localhost
ANJU_FORWARDED_ALLOW_IPS=172.30.25.2
ANJU_ENABLE_API_DOCS=0
ANJU_MOCK_ANALYSIS=0

ANJU_VISION_PROVIDER=ark
ARK_API_KEY=replace-with-server-side-secret
ANJU_ARK_MODEL=doubao-seed-2-1-pro-260628
ANJU_ANALYSIS_TIMEOUT_SECONDS=60
ANJU_TURBO_MAX_CONCURRENCY=2
ANJU_PRO_MAX_CONCURRENCY=1
ANJU_SHARE_TTL_HOURS=24
# Legacy H5 video analysis is cancelled; never enable this compatibility switch.
ANJU_ENABLE_H5_VIDEO=0
ANJU_ENABLE_H5_CAMERA=0
ANJU_ENABLE_IOS_HOME_CAMERA=0
ANJU_ENABLE_VOICE_ADVISOR=0
ANJU_ENABLE_KNOWLEDGE_ADVISOR=0
ANJU_KNOWLEDGE_ADVISOR_MODEL=
ANJU_KNOWLEDGE_ADVISOR_TIMEOUT_SECONDS=30
ANJU_ENABLE_RTC_VIDEO_ADVISOR=0
# Hard-capped at 8 in the service to preserve two TTS concurrency lanes.
ANJU_ADVISOR_MAX_ACTIVE_RTC=8
ANJU_ADVISOR_MAX_QUEUED=50
ANJU_ADVISOR_QUEUE_TTL_SECONDS=180
ANJU_ADVISOR_QUEUE_GRANT_SECONDS=20
ANJU_ADVISOR_DEVICE_LEASE_SECONDS=90
ANJU_VOLC_FC_CALLBACK_URL=https://shotapi.socialdog.cn/api/internal/rtc/function-calls
ANJU_VOLC_FC_CALLBACK_SIGNATURE=replace-with-independent-high-entropy-signature
ANJU_VOLC_RTC_APP_ID=replace-with-rtc-app-id
ANJU_VOLC_RTC_APP_KEY=replace-with-server-side-secret
ANJU_VOLC_ACCESS_KEY=replace-with-server-side-secret
ANJU_VOLC_SECRET_KEY=replace-with-server-side-secret
ANJU_VOLC_VOICE_CONFIG_JSON=replace-with-server-side-json
ANJU_VOLC_VOICE_API_VERSION=2025-06-01
ANJU_VOLC_VOICE_MODEL_ID=doubao-seed-2-1-turbo-260628
ANJU_ENABLE_RENOVATION_PREVIEW=0
ANJU_ARK_IMAGE_EDIT_MODEL=doubao-seedream-4-5-251128
ANJU_ARK_IMAGE_EDIT_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
ANJU_ARK_IMAGE_EDIT_SIZE=2K
ANJU_ARK_RENOVATION_GROUNDING_MODEL=doubao-seed-2-1-pro-260628
ANJU_RENOVATION_PREVIEW_TIMEOUT_SECONDS=90
ANJU_RENOVATION_PREVIEW_DAILY_LIMIT=3
ANJU_ARK_TURBO_MODEL=doubao-seed-2-0-lite-260215
ANJU_ARK_HOME_CAMERA_MODEL=doubao-seed-2-1-turbo-260628
ANJU_ARK_PRO_MODEL=doubao-seed-2-1-pro-260628
